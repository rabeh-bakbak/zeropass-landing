        function switchLanguage(lang) {
            const isAr = lang === 'ar';
            document.documentElement.setAttribute('lang', lang);
            document.documentElement.setAttribute('dir', isAr ? 'rtl' : 'ltr');

            const btnEn = document.getElementById('btn-en');
            const btnFr = document.getElementById('btn-fr');
            const btnAr = document.getElementById('btn-ar');

            const activeClass = "px-2.5 py-1 text-xs font-semibold rounded-lg transition duration-200 bg-brand-600 text-white shadow";
            const inactiveClass = "px-2.5 py-1 text-xs font-semibold rounded-lg transition duration-200 text-slate-400 hover:text-white";

            btnEn.className = lang === 'en' ? activeClass : inactiveClass;
            btnFr.className = lang === 'fr' ? activeClass : inactiveClass;
            btnAr.className = lang === 'ar' ? activeClass : inactiveClass;

            const elements = document.querySelectorAll('[data-i18n]');
            elements.forEach(element => {
                const key = element.getAttribute('data-i18n');
                if (translations[lang] && translations[lang][key]) {
                    element.textContent = translations[lang][key];
                }
            });

            localStorage.setItem('zeropass_lang', lang);
        }

        function openModal() {
            const modal = document.getElementById('info-modal');
            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
            }, 10);
        }

        function closeModal() {
            const modalEl = document.getElementById('info-modal');
            modalEl.classList.add('opacity-0');
            setTimeout(() => {
                modalEl.classList.add('hidden');
            }, 300);
        }

        window.addEventListener('DOMContentLoaded', () => {
            const savedLang = localStorage.getItem('zeropass_lang') || 'en';
            switchLanguage(savedLang);
        });
    </script>
